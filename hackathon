<!DOCTYPE html>
<html>
<head>
  <title>Homework Tracker MVP</title>
  <style>
    body { font-family: Arial; padding: 20px; }
    #assignments div { margin-bottom: 5px; }
  </style>
</head>
<body>
  <h1>Homework Tracker MVP</h1>

  <input id="classInput" placeholder="Class">
  <input id="assignmentInput" placeholder="Assignment">
  <button onclick="addAssignment()">Add Assignment</button>

  <h2>Assignments</h2>
  <div id="assignments"></div>

  <script>
    function addAssignment() {
      let cls = document.getElementById("classInput").value;
      let asn = document.getElementById("assignmentInput").value;

      if (cls && asn) {
        let item = document.createElement("div");
        item.textContent = cls + ": " + asn;
        document.getElementById("assignments").appendChild(item);
      }
    }
  </script>
</body>
</html>
    
