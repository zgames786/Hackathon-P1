rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Helper function to check if request has admin UID
    function hasAdminAuth() {
      // For compat with current setup where admins collection uses username as doc ID
      // Admin must be authenticated via Firebase Auth
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Admins collection - only readable by authenticated admins
    match /admins/{adminId} {
      allow read: if hasAdminAuth();
      allow write: if false; // Admins created via admin-create.html or console only
    }
    
    // Users collection (teachers and students)
    match /users/{userId} {
      // Only admins can read all user documents
      allow read: if hasAdminAuth();
      
      // Only admins can create, update, or delete user documents
      allow create, update, delete: if hasAdminAuth();
    }
    
    // Classes collection
    match /classes/{classId} {
      // Admins can read all classes
      allow read: if hasAdminAuth();
      
      // Admins can create, update, delete classes
      allow write: if hasAdminAuth();
    }
    
    // Student fees collection
    match /studentFees/{feeId} {
      // Only admins can access fees
      allow read, write: if hasAdminAuth();
    }
    
    // Payments collection
    match /payments/{paymentId} {
      // Only admins can access payments
      allow read, write: if hasAdminAuth();
    }
    
    // Attendance collection
    match /attendance/{attendanceId} {
      // Only admins can access attendance records
      allow read, write: if hasAdminAuth();
    }
    
    // Students collection (legacy - if used)
    match /students/{studentId} {
      allow read, write: if hasAdminAuth();
    }
    
    // Teachers collection (legacy - if used)
    match /teachers/{teacherId} {
      allow read, write: if hasAdminAuth();
    }
    
    // Fee categories
    match /feeCategories/{categoryId} {
      allow read, write: if hasAdminAuth();
    }
    
    // Suggestions collection
    match /suggestions/{suggestionId} {
      // Students can create suggestions (they don't use Firebase Auth, so allow creates)
      // Validate that required fields are present: text, studentUid, timestamp
      allow create: if request.resource.data.keys().hasAll(['text', 'studentUid', 'timestamp']) &&
                    request.resource.data.text is string &&
                    request.resource.data.studentUid is string;
      
      // Students cannot read, update, or delete suggestions
      allow read: if hasAdminAuth();
      allow update: if false;
      allow delete: if hasAdminAuth();
    }
    
    // Deny all other requests by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/* 
IMPORTANT NOTES:

1. These rules ensure that only authenticated admins can access the database.
2. Teachers and students DO NOT use Firebase Auth in the current implementation.
   They use Firestore-only authentication with hashed passwords.
3. Only admin accounts are authenticated via Firebase Auth.
4. The isAdmin() and hasAdminAuth() functions check if the authenticated user
   exists in the admins collection.

DEPLOYMENT:
To deploy these rules to your Firebase project:
1. Go to Firebase Console > Firestore Database > Rules
2. Copy and paste these rules
3. Click "Publish"

TESTING:
After deployment, test that:
- Admins can log in and access all collections
- Teachers and students can log in (Firestore-based auth)
- Unauthenticated users cannot access any data
*/
